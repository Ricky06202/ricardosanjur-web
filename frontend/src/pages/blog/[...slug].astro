---
import BlogPostPage from '../../components/pages/BlogPostPage.astro';
import { getCollection } from 'astro:content';

/* Los artículos del repo son los de antes (.md). Los nuevos los publica el dueño
 * desde el panel /admin y los sirve el worker desde la base, en la misma dirección. */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogPostPage lang="es" post={post} />
