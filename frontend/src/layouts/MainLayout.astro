---
import { ui, type Lang } from "../i18n/ui";
import { routeKeys, routeHref, getLangFromUrl, otherLang, switchPath, alternates } from "../i18n/utils";
import LangSwitch from "../components/LangSwitch.astro";

interface Crumb { name: string; path: string }

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  ogType?: "website" | "article";
  breadcrumbs?: Crumb[];
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  noindex?: boolean;
  /** Contenido sin estilo propio (un artículo HTML): el layout no le toca el formato. */
  cuerpoLibre?: boolean;
}

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = ui[lang];

const {
  title,
  description = t.meta.defaultDescription,
  image = "/og/og-default.jpg",
  ogType = "website",
  breadcrumbs = [],
  extraJsonLd,
  publishedTime,
  modifiedTime,
  noindex = false,
  cuerpoLibre = false,
} = Astro.props;

const origin = (Astro.site ? new URL("/", Astro.site).href : "https://www.ricardosanjur.com/").replace(/\/$/, "");
const base = Astro.site ?? origin;
const nav = routeKeys.map((key) => ({ href: routeHref(key, lang), label: t.navLabels[key] }));
const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (href !== "/" && href !== "/en/" && path.startsWith(href));
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const alt = alternates(Astro.url, Astro.site);
const other = otherLang(lang);
const switchHref = switchPath(path, other);
const absImage = new URL(image, base).href;
const pageTitle = `${title} | ${t.meta.titleSuffix}`;
const ogLocaleAlt = other === "en" ? "en_US" : "es_PA";

const orgId = `${origin}/#organization`;
const siteId = `${origin}/#website`;

const org = {
  "@type": "ProfessionalService",
  "@id": orgId,
  name: "Topografía Especializada, S.A.",
  alternateName: "Ricardo A. Sanjur A.",
  url: new URL(routeHref("home", lang), base).href,
  logo: new URL("/images/logo-sin-fondopng-con-www.png", base).href,
  image: absImage,
  description: t.meta.defaultDescription,
  telephone: "+50766714646",
  email: "gerencia@ricardosanjur.com",
  foundingDate: "1970",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle B Sur y Segunda Oeste, Diag. al Colegio Sucre",
    addressLocality: "David",
    addressRegion: "Chiriquí",
    addressCountry: "PA",
  },
  areaServed: { "@type": "Country", name: "Panamá" },
  knowsAbout: ["Topografía", "Geodesia", "GNSS", "SIG", "Geomática", "Catastro"],
  knowsLanguage: ["es", "en"],
};

const website = {
  "@type": "WebSite",
  "@id": siteId,
  url: new URL(routeHref("home", lang), base).href,
  name: t.meta.siteName,
  inLanguage: lang,
  publisher: { "@id": orgId },
};

const graph: Record<string, unknown>[] = [org, website];
if (breadcrumbs.length > 0) {
  const items = [
    { name: t.navLabels.home, url: new URL(routeHref("home", lang), base).href },
    ...breadcrumbs.map((c) => ({ name: c.name, url: new URL(c.path, base).href })),
  ];
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: items.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: c.url,
    })),
  });
}
const extra = extraJsonLd ? (Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd]) : [];
const jsonLd = { "@context": "https://schema.org", "@graph": [...graph, ...extra] };
---

<!doctype html>
<html lang={lang} data-theme="topoblue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alt.es} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.es} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={absImage} />
    <meta property="og:image:secure_url" content={absImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title.includes(t.meta.titleSuffix) ? title : title + ' | ' + t.meta.titleSuffix}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased">
    <header class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-xl">
      <nav class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
        <a href={routeHref("home", lang)} class="flex shrink-0 items-center gap-3" aria-label={t.ariaHome}>
          <span class="flex items-center rounded-2xl bg-white px-2.5 py-1.5 shadow-lg shadow-primary/25 ring-1 ring-white/20">
            <img src="/images/logo-sin-fondopng-con-www.png" alt="Topografía Especializada" class="h-12 w-auto" />
          </span>
          <span class="hidden font-display text-sm font-bold leading-tight sm:block">
            TOPOGRAFÍA<br /><span class="text-primary">ESPECIALIZADA</span>
          </span>
        </a>

        <div class="ml-auto hidden items-center gap-1 lg:flex">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  "rounded-full px-4 py-2 font-mono text-xs uppercase tracking-widest transition-colors",
                  isActive(n.href) ? "bg-primary/10 text-primary" : "text-base-content/70 hover:text-primary",
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </div>

        <LangSwitch lang={lang} />

        <a href={routeHref("services", lang) + "#cotizacion"} class="btn btn-primary btn-sm ml-auto rounded-full lg:ml-0">
          {t.ctaQuote}
        </a>

        <div class="dropdown dropdown-end lg:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
          </div>
          <ul tabindex="0" class="menu dropdown-content z-[1] mt-3 w-56 rounded-box border border-white/10 bg-base-200 p-2 shadow-2xl">
            {nav.map((n) => (<li><a href={n.href} class={isActive(n.href) ? "text-primary" : ""}>{n.label}</a></li>))}
            <LangSwitch lang={lang} variant="mobile" />
          </ul>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      {cuerpoLibre ? (
        <div class="cuerpo-libre">
          <slot />
        </div>
      ) : (
        <slot />
      )}
    </main>

    <!-- WhatsApp flotante (foto del Ing. Sanjur).
         El mensaje sale ya escrito y dice de qué página escribe, para saber que
         viene del sitio web (pedido de Doña Eysbel, 18/10). Arriba del botón se
         ve el mismo texto, así sabe lo que va a mandar antes de tocar. -->
    <a id="wa-flotante" href="https://wa.me/50766714646" target="_blank" rel="noopener" aria-label="Escríbanos por WhatsApp"
       class="group fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-full bg-white/95 p-1.5 pr-1.5 shadow-2xl shadow-black/40 ring-1 ring-black/5 backdrop-blur transition hover:scale-105 sm:pr-5">
      <span class="relative block h-14 w-14 shrink-0 overflow-hidden rounded-full ring-2 ring-[#25D366]">
        <img src="/images/whatsapp-ricardo-2.jpg" alt="Ing. Ricardo Sanjur" width="112" height="112" class="h-full w-full object-cover" />
        <span class="absolute bottom-0 right-0 flex h-5 w-5 items-center justify-center rounded-full bg-[#25D366] ring-2 ring-white">
          <svg viewBox="0 0 32 32" class="h-3 w-3" fill="#fff" aria-hidden="true"><path d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.13.56 4.2 1.62 6.03L4 29l8.1-1.58a12 12 0 0 0 3.94.66h.01c6.63 0 12.03-5.4 12.03-12.04C28.08 8.4 22.68 3 16.04 3zm0 22.8h-.01a10 10 0 0 1-5.1-1.4l-.36-.21-3.8.74.76-3.7-.24-.38a9.9 9.9 0 0 1-1.52-5.3c0-5.5 4.48-9.98 10-9.98 2.67 0 5.18 1.04 7.07 2.93a9.9 9.9 0 0 1 2.92 7.06c0 5.51-4.48 9.99-9.99 9.99z"/></svg>
        </span>
      </span>
      <span class="hidden font-semibold leading-tight text-[#0b1220] sm:block">
        <span class="block text-[10px] font-mono uppercase tracking-widest text-[#25D366]">WhatsApp</span>
        <span class="block text-sm">Escríbanos por WhatsApp</span>
      </span>
    </a>
    <!-- Lo que se le manda: se ve arriba del botón y se puede tocar para cerrar. -->
    <div id="wa-globo" class="fixed bottom-[96px] right-3 z-40 hidden max-w-[260px] rounded-2xl rounded-br-md bg-white py-2 pl-3 pr-9 text-[13px] leading-snug text-[#0b1220] shadow-xl shadow-black/20 ring-1 ring-black/5 sm:right-5 sm:bottom-[100px]">
      <button type="button" id="wa-globo-cerrar" class="absolute right-1 top-1 flex h-7 w-7 items-center justify-center rounded-full text-base-content/40 hover:text-base-content/80" aria-label="Cerrar">&times;</button>
      <span id="wa-globo-texto"></span>
    </div>

    <footer class="relative mt-24 border-t border-black/5">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <span class="inline-flex items-center rounded-2xl bg-white px-3 py-2 shadow-lg shadow-primary/20">
            <img src="/images/logo-sin-fondopng-con-www.png" alt="Topografía Especializada" class="h-20 w-auto" />
          </span>
          <p class="mt-4 max-w-sm text-sm text-base-content/70">
            {t.footer.tagline}
          </p>
          <p class="mt-4 font-mono text-[11px] uppercase tracking-widest text-primary">{t.footer.since}</p>
        </div>

        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-base-content/50">{t.footer.navHeading}</h4>
          <ul class="mt-4 space-y-2 text-sm">
            {nav.map((n) => (<li><a href={n.href} class="touch-link text-base-content/75 transition-colors hover:text-primary">{n.label}</a></li>))}
          </ul>
        </div>

        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-base-content/50">{t.footer.contactHeading}</h4>
          <ul class="mt-4 space-y-2 text-sm text-base-content/75">
            <li>Calle B Sur y Segunda Oeste, Diag. al Colegio Sucre</li>
            <li>David, Chiriquí, Panamá</li>
            <li><a href="tel:+50766714646" class="touch-link transition-colors hover:text-primary">+507 6671-4646</a></li>
            <li><a href="mailto:gerencia@ricardosanjur.com" class="touch-link transition-colors hover:text-primary">gerencia@ricardosanjur.com</a></li>
          </ul>
        </div>
      </div>
      <div class="relative border-t border-black/5">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs text-base-content/50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <p>© {new Date().getFullYear()} Topografía Especializada S.A. · Ricardo A. Sanjur A.</p>
          <p class="font-mono">{t.footer.rights}</p>
          <a href="https://rsanjur.com/#contacto" target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition-colors hover:text-primary">
            <img src="/images/rs-logo.svg" alt="rsanjur.com" class="h-5 w-5 rounded-md" />
            <span>{t.footer.madeBy} <strong class="text-base-content/80">rsanjur.com</strong> · {t.footer.madeByCta}</span>
          </a>
        </div>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // WhatsApp con el mensaje ya escrito y la página de donde escribe. Se arma
      // aquí (no en el HTML) porque cambia según la página en la que esté.
      (() => {
        const boton = document.getElementById("wa-flotante") as HTMLAnchorElement | null;
        if (!boton) return;
        const camino = (window.location.pathname || "/").replace(/\/+$/, "") || "/";
        const paginas: Record<string, [string, string]> = {
          // [español, inglés]
          "/": ["la página principal", "the home page"],
          "/services": ["la página de servicios", "the services page"],
          "/about": ["la página de nosotros", "the about page"],
          "/contact": ["la página de contacto", "the contact page"],
          "/blog": ["el blog", "the blog"],
          "/en": ["la página principal", "the home page"],
          "/en/services": ["la página de servicios", "the services page"],
          "/en/about": ["la página de nosotros", "the about page"],
          "/en/contact": ["la página de contacto", "the contact page"],
          "/en/blog": ["el blog", "the blog"],
        };
        // El mensaje va SIEMPRE en español: es el canal de la oficina (Doña Eysbel).
        // Dice la página y el enlace completo, así se sabe de dónde viene.
        const esBlogYa = /^\/blog\//.test(camino) || /^\/en\/blog\//.test(camino);
        const donde = paginas[camino] ? paginas[camino][0] : esBlogYa ? "el blog" : "la página web";
        const enlace = location.origin + (camino === "/" ? "" : camino);
        const texto = `Hola, escribo desde ${donde} (${enlace}). Vi su página web y quiero consultarles.`;
        boton.href = "https://wa.me/50766714646?text=" + encodeURIComponent(texto);
        const globo = document.getElementById("wa-globo");
        const textoGlobo = document.getElementById("wa-globo-texto");
        const cerrar = document.getElementById("wa-globo-cerrar");
        if (globo && textoGlobo) {
          textoGlobo.textContent = "Toque y el mensaje va listo: ya dice desde qué página nos escribe.";
          // Se muestra a los 2 s (sin tapar la pantalla al entrar) y vuelve cada 5 visitas.
          const visto = Number(localStorage.getItem("wa_globo_visto") || "0");
          localStorage.setItem("wa_globo_visto", String(visto + 1));
          if (visto % 5 === 0) setTimeout(() => globo.classList.remove("hidden"), 2000);
        }
        cerrar?.addEventListener("click", (e) => {
          e.preventDefault();
          globo?.classList.add("hidden");
        });
      })();

      // Manual language preference: persist the choice in a cookie (1 year).
      document.querySelectorAll("[data-lang-switch]").forEach((el) => {
        el.addEventListener("click", () => {
          const value = el.getAttribute("data-lang-switch") || "es";
          document.cookie = "lang=" + value + "; path=/; max-age=31536000; SameSite=Lax";
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  /* Artículo HTML escrito a mano: el layout solo le pone marco y ancho legible;
   * el diseño de adentro es el del archivo (para que salga igual a como lo ve él). */
  .cuerpo-libre {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px 18px 56px;
    overflow-wrap: break-word;
  }
  .cuerpo-libre > .blog-post {
    font-family: Georgia, "Times New Roman", serif;
    color: #1c2b33;
    line-height: 1.65;
    font-size: 18px;
  }
  .cuerpo-libre > .blog-post h1 { font-size: clamp(26px, 4.4vw, 38px); line-height: 1.18; letter-spacing: -0.02em; margin: 0 0 12px; color: #123b4a; }
  .cuerpo-libre > .blog-post h2 { font-size: 24px; line-height: 1.25; margin: 34px 0 10px; color: #123b4a; }
  .cuerpo-libre > .blog-post h3 { font-size: 19px; margin: 26px 0 8px; color: #123b4a; }
  .cuerpo-libre > .blog-post p { margin: 0 0 16px; }
  .cuerpo-libre > .blog-post .post-meta { color: #5b6b7a; font-size: 15px; }
  .cuerpo-libre > .blog-post ul,
  .cuerpo-libre > .blog-post ol { margin: 0 0 18px; padding-left: 22px; }
  .cuerpo-libre > .blog-post li { margin-bottom: 8px; }
  .cuerpo-libre > .blog-post a { color: #157377; }
  .cuerpo-libre > .blog-post hr { border: 0; border-top: 1px solid #e3e8ee; margin: 30px 0; }
  .cuerpo-libre > .blog-post img { max-width: 100%; height: auto; }
  /* Tabla ancha en celular: colapsa en fichas (una por fila) en vez de pedir
   * que el lector arrastre la tabla a los lados. El diseño del texto no se toca. */
  @media (max-width: 640px) {
    .cuerpo-libre > .blog-post table,
    .cuerpo-libre > .blog-post thead,
    .cuerpo-libre > .blog-post tbody,
    .cuerpo-libre > .blog-post tr,
    .cuerpo-libre > .blog-post th,
    .cuerpo-libre > .blog-post td { display: block; width: 100% !important; }
    .cuerpo-libre > .blog-post table { min-width: 0 !important; border: 0 !important; }
    .cuerpo-libre > .blog-post thead { display: none; }
    .cuerpo-libre > .blog-post tr {
      margin: 0 0 14px;
      border: 1px solid #d0d7de;
      border-radius: 12px;
      overflow: hidden;
      background: #fff !important;
    }
    .cuerpo-libre > .blog-post td { border: 0 !important; border-bottom: 1px solid #e8edf2 !important; font-size: 16px; }
    .cuerpo-libre > .blog-post td:last-child { border-bottom: 0 !important; }
    .cuerpo-libre > .blog-post td:first-child { background: #123059 !important; color: #fff !important; }
    .cuerpo-libre > .blog-post td:first-child strong { color: #fff !important; }
    /* La fila de encabezado del thead ya se ocultó; los th que van en el cuerpo también se listan como datos. */
    .cuerpo-libre > .blog-post tbody th { display: block; width: 100%; }
  }
  .cuerpo-libre > .blog-post table { min-width: 620px; font-size: 15px; }
  .cuerpo-libre > .blog-post blockquote { margin: 20px 0; }
</style>
