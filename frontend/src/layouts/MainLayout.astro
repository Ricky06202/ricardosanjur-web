---
import { ui, type Lang } from "../i18n/ui";
import { routeKeys, routeHref, getLangFromUrl, otherLang, switchPath, alternates } from "../i18n/utils";
import LangSwitch from "../components/LangSwitch.astro";

interface Crumb { name: string; path: string }

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
  ogType?: "website" | "article";
  breadcrumbs?: Crumb[];
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  noindex?: boolean;
}

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = ui[lang];

const {
  title,
  description = t.meta.defaultDescription,
  image = "/og/og-default.jpg",
  ogType = "website",
  breadcrumbs = [],
  extraJsonLd,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const origin = (Astro.site ? new URL("/", Astro.site).href : "https://www.ricardosanjur.com/").replace(/\/$/, "");
const base = Astro.site ?? origin;
const nav = routeKeys.map((key) => ({ href: routeHref(key, lang), label: t.navLabels[key] }));
const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (href !== "/" && href !== "/en/" && path.startsWith(href));
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const alt = alternates(Astro.url, Astro.site);
const other = otherLang(lang);
const switchHref = switchPath(path, other);
const absImage = new URL(image, base).href;
const pageTitle = `${title} | ${t.meta.titleSuffix}`;
const ogLocaleAlt = other === "en" ? "en_US" : "es_PA";

const orgId = `${origin}/#organization`;
const siteId = `${origin}/#website`;

const org = {
  "@type": "ProfessionalService",
  "@id": orgId,
  name: "Topografía Especializada, S.A.",
  alternateName: "Ricardo A. Sanjur A.",
  url: new URL(routeHref("home", lang), base).href,
  logo: new URL("/images/logo-sin-fondopng-con-www.png", base).href,
  image: absImage,
  description: t.meta.defaultDescription,
  telephone: "+50766714646",
  email: "gerencia@ricardosanjur.com",
  foundingDate: "1970",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle B Sur y Segunda Oeste, Diag. al Colegio Sucre",
    addressLocality: "David",
    addressRegion: "Chiriquí",
    addressCountry: "PA",
  },
  areaServed: { "@type": "Country", name: "Panamá" },
  knowsAbout: ["Topografía", "Geodesia", "GNSS", "SIG", "Geomática", "Catastro"],
  knowsLanguage: ["es", "en"],
};

const website = {
  "@type": "WebSite",
  "@id": siteId,
  url: new URL(routeHref("home", lang), base).href,
  name: t.meta.siteName,
  inLanguage: lang,
  publisher: { "@id": orgId },
};

const graph: Record<string, unknown>[] = [org, website];
if (breadcrumbs.length > 0) {
  const items = [
    { name: t.navLabels.home, url: new URL(routeHref("home", lang), base).href },
    ...breadcrumbs.map((c) => ({ name: c.name, url: new URL(c.path, base).href })),
  ];
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: items.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: c.url,
    })),
  });
}
const extra = extraJsonLd ? (Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd]) : [];
const jsonLd = { "@context": "https://schema.org", "@graph": [...graph, ...extra] };
---

<!doctype html>
<html lang={lang} data-theme="topoblue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alt.es} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.es} />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={absImage} />
    <meta property="og:image:secure_url" content={absImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} | {t.meta.titleSuffix}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased">
    <header class="sticky top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur-xl">
      <nav class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
        <a href={routeHref("home", lang)} class="flex shrink-0 items-center gap-3" aria-label={t.ariaHome}>
          <span class="flex items-center rounded-2xl bg-white px-2.5 py-1.5 shadow-lg shadow-primary/25 ring-1 ring-white/20">
            <img src="/images/logo-sin-fondopng-con-www.png" alt="Topografía Especializada" class="h-12 w-auto" />
          </span>
          <span class="hidden font-display text-sm font-bold leading-tight sm:block">
            TOPOGRAFÍA<br /><span class="text-primary">ESPECIALIZADA</span>
          </span>
        </a>

        <div class="ml-auto hidden items-center gap-1 lg:flex">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  "rounded-full px-4 py-2 font-mono text-xs uppercase tracking-widest transition-colors",
                  isActive(n.href) ? "bg-primary/10 text-primary" : "text-base-content/70 hover:text-primary",
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </div>

        <LangSwitch lang={lang} />

        <a href={routeHref("services", lang) + "#cotizacion"} class="btn btn-primary btn-sm ml-auto rounded-full lg:ml-0">
          {t.ctaQuote}
        </a>

        <div class="dropdown dropdown-end lg:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
          </div>
          <ul tabindex="0" class="menu dropdown-content z-[1] mt-3 w-56 rounded-box border border-white/10 bg-base-200 p-2 shadow-2xl">
            {nav.map((n) => (<li><a href={n.href} class={isActive(n.href) ? "text-primary" : ""}>{n.label}</a></li>))}
            <LangSwitch lang={lang} variant="mobile" />
          </ul>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- WhatsApp flotante (foto del Ing. Sanjur) -->
    <a href="https://wa.me/50766714646" target="_blank" rel="noopener" aria-label="Escríbanos por WhatsApp"
       class="group fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-full bg-white/95 p-1.5 pr-1.5 shadow-2xl shadow-black/40 ring-1 ring-black/5 backdrop-blur transition hover:scale-105 sm:pr-5">
      <span class="relative block h-14 w-14 shrink-0 overflow-hidden rounded-full ring-2 ring-[#25D366]">
        <img src="/images/whatsapp-ricardo-2.jpg" alt="Ing. Ricardo Sanjur" width="112" height="112" class="h-full w-full object-cover" />
        <span class="absolute bottom-0 right-0 flex h-5 w-5 items-center justify-center rounded-full bg-[#25D366] ring-2 ring-white">
          <svg viewBox="0 0 32 32" class="h-3 w-3" fill="#fff" aria-hidden="true"><path d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.13.56 4.2 1.62 6.03L4 29l8.1-1.58a12 12 0 0 0 3.94.66h.01c6.63 0 12.03-5.4 12.03-12.04C28.08 8.4 22.68 3 16.04 3zm0 22.8h-.01a10 10 0 0 1-5.1-1.4l-.36-.21-3.8.74.76-3.7-.24-.38a9.9 9.9 0 0 1-1.52-5.3c0-5.5 4.48-9.98 10-9.98 2.67 0 5.18 1.04 7.07 2.93a9.9 9.9 0 0 1 2.92 7.06c0 5.51-4.48 9.99-9.99 9.99z"/></svg>
        </span>
      </span>
      <span class="hidden font-semibold leading-tight text-[#0b1220] sm:block">
        <span class="block text-[10px] font-mono uppercase tracking-widest text-[#25D366]">WhatsApp</span>
        <span class="block text-sm">Escríbanos</span>
      </span>
    </a>

    <footer class="relative mt-24 border-t border-black/5">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <span class="inline-flex items-center rounded-2xl bg-white px-3 py-2 shadow-lg shadow-primary/20">
            <img src="/images/logo-sin-fondopng-con-www.png" alt="Topografía Especializada" class="h-20 w-auto" />
          </span>
          <p class="mt-4 max-w-sm text-sm text-base-content/70">
            {t.footer.tagline}
          </p>
          <p class="mt-4 font-mono text-[11px] uppercase tracking-widest text-primary">{t.footer.since}</p>
        </div>

        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-base-content/50">{t.footer.navHeading}</h4>
          <ul class="mt-4 space-y-2 text-sm">
            {nav.map((n) => (<li><a href={n.href} class="touch-link text-base-content/75 transition-colors hover:text-primary">{n.label}</a></li>))}
          </ul>
        </div>

        <div>
          <h4 class="font-mono text-[11px] uppercase tracking-widest text-base-content/50">{t.footer.contactHeading}</h4>
          <ul class="mt-4 space-y-2 text-sm text-base-content/75">
            <li>Calle B Sur y Segunda Oeste, Diag. al Colegio Sucre</li>
            <li>David, Chiriquí, Panamá</li>
            <li><a href="tel:+50766714646" class="touch-link transition-colors hover:text-primary">+507 6671-4646</a></li>
            <li><a href="mailto:gerencia@ricardosanjur.com" class="touch-link transition-colors hover:text-primary">gerencia@ricardosanjur.com</a></li>
          </ul>
        </div>
      </div>
      <div class="relative border-t border-black/5">
        <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs text-base-content/50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
          <p>© {new Date().getFullYear()} Topografía Especializada S.A. · Ricardo A. Sanjur A.</p>
          <p class="font-mono">{t.footer.rights}</p>
          <a href="https://rsanjur.com/#contacto" target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition-colors hover:text-primary">
            <img src="/images/rs-logo.svg" alt="rsanjur.com" class="h-5 w-5 rounded-md" />
            <span>{t.footer.madeBy} <strong class="text-base-content/80">rsanjur.com</strong> · {t.footer.madeByCta}</span>
          </a>
        </div>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Manual language preference: persist the choice in a cookie (1 year).
      document.querySelectorAll("[data-lang-switch]").forEach((el) => {
        el.addEventListener("click", () => {
          const value = el.getAttribute("data-lang-switch") || "es";
          document.cookie = "lang=" + value + "; path=/; max-age=31536000; SameSite=Lax";
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
