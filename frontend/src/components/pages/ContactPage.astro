---
import MainLayout from "../../layouts/MainLayout.astro";
import MapaOsm from "../MapaOsm.astro";
import { ui, type Lang } from "../../i18n/ui";
import { routeHref } from "../../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contact;
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Topografia%20Especializada%2C%20Geomatic%20Mall%2C%20C.%20B%20Sur%2C%20David%2C%20Chiriqui";
/* El mapa se dibuja con OpenStreetMap (componente MapaOsm). El link de Google
 * queda SOLO para "abrir en tu app de mapas": es lo que el telefono entiende y
 * le da indicaciones al chofer. El iframe de Google ya no se usa. */
const mapEmbed = "https://www.google.com/maps?q=8.4270199,-82.4296357&z=17&hl=es&output=embed";
---

<MainLayout
  title={c.title}
  description={c.description}
  lang={lang}
  breadcrumbs={[{ name: c.title, path: routeHref("contact", lang) }]}
>

  <!-- Hero -->
  <section class="relative h-[40vh] min-h-[350px] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/Daniel-y-Yo.jpg" alt={c.heroImageAlt} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="relative z-10 h-full flex items-end pb-12">
      <div class="container mx-auto px-4 text-center">
        <div class="badge badge-primary badge-outline mb-4">{c.badge}</div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={c.heading} />
      </div>
    </div>
  </section>

  <!-- Info y Formulario -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Información de Contacto -->
        <div>
          <h2 class="text-2xl font-bold mb-8">{c.infoHeading}</h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg">{c.addressHeading}</h3>
                <p class="text-base-content/70">
                  {c.addressLine1}<br/>
                  {c.addressLine2}<br/>
                  {c.addressLine3}
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-secondary/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg">{c.phoneHeading}</h3>
                <p class="text-base-content/70">
                  <a href="tel:+50766714646" class="touch-link link link-primary">+507 6671-4646</a>
                </p>
                <p class="text-sm text-base-content/50 mt-1">{c.hours}</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg">{c.emailHeading}</h3>
                <p class="text-base-content/70">
                  <a href="mailto:asistente@ricardosanjur.com" class="touch-link link link-primary">asistente@ricardosanjur.com</a>
                </p>
              </div>
            </div>
          </div>

          <!-- Mapa Estático -->
          <div class="mt-8">
            <h3 class="font-semibold text-lg mb-4">{c.locationHeading}</h3>
            <div class="card bg-base-100 shadow-xl overflow-hidden">
              <figure class="bg-base-200">
                <MapaOsm altura="16rem" titulo="Ubicación de Topografía Especializada en el mapa" />
              </figure>
              <div class="card-body py-4">
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="touch-link link link-primary text-sm">{c.viewMaps} &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario de Contacto -->
        <div>
          <h2 class="text-2xl font-bold mb-8">{c.formHeading}</h2>

          <form class="card bg-base-100 shadow-xl" id="contactForm" method="post" action="/api/contact" data-msg-sent={c.msgSent} data-msg-error={c.msgError} data-msg-conn={c.msgConnError}>
            <div class="card-body space-y-4">
              <div class="form-control">
                <label class="label"><span class="label-text">{c.labelFullName}</span></label>
                <input type="text" name="nombre" class="input input-bordered" required placeholder={c.placeholderName} />
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text">{c.labelEmail}</span></label>
                <input type="email" name="email" class="input input-bordered" required placeholder={c.placeholderEmail} />
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text">{c.labelPhone}</span></label>
                <input type="tel" name="telefono" class="input input-bordered" placeholder={c.placeholderPhone} />
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text">{c.labelSubject}</span></label>
                <select name="tema" class="select select-bordered" required>
                  <option value="">{c.selectSubject}</option>
                  {c.subjects.map((subj) => (<option value={subj.value}>{subj.label}</option>))}
                </select>
              </div>

              <div class="form-control">
                <label class="label"><span class="label-text">{c.labelMessage}</span></label>
                <textarea name="mensaje" class="textarea textarea-bordered h-32" required placeholder={c.placeholderMessage}></textarea>
              </div>

              <div class="form-control mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  {c.submit}
                </button>
              </div>
              <p class="text-xs leading-relaxed text-base-content/60">{c.privacyNotice}</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa Completo -->
  <section class="py-10 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold">{c.howToGetHeading}</h2>
        <p class="text-base-content/70">{c.howToGetLead}</p>
      </div>
      <div class="card bg-base-100 shadow-xl overflow-hidden">
        <div class="bg-base-200">
          <MapaOsm altura="22rem" titulo="Mapa de la oficina de Topografía Especializada" />
        </div>
        <div class="card-body items-center text-center">
          <p class="text-lg font-medium">Topografía Especializada S.A.</p>
          <p class="text-base-content/70">{c.addressLine1} {c.addressLine2} — {c.addressLine3}</p>
          <p class="text-base-content/70">Tel/WhatsApp: <a href="https://wa.me/50766714646" target="_blank" rel="noopener" class="touch-link link link-primary">+507 6671-4646</a></p>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            {c.openMaps}
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const messages = {
    sent: form?.dataset.msgSent || "",
    error: form?.dataset.msgError || "",
    conn: form?.dataset.msgConn || "",
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(formData)),
        headers: {
          'Content-Type': 'application/json'
        }
      });

      if (response.ok) {
        alert(messages.sent);
        form.reset();
      } else {
        alert(messages.error);
      }
    } catch (error) {
      alert(messages.conn);
    }
  });
</script>
