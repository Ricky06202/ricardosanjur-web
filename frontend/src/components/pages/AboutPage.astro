---
import MainLayout from "../../layouts/MainLayout.astro";
import { ui, type Lang } from "../../i18n/ui";
import { routeHref } from "../../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const a = t.about;
---

<MainLayout
  title={a.title}
  description={a.description}
  lang={lang}
  breadcrumbs={[{ name: a.title, path: routeHref("about", lang) }]}
>

  <!-- Hero -->
  <section class="relative h-[50vh] min-h-[400px] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/homeheader-1.jpg" alt={a.heroImageAlt} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="relative z-10 h-full flex items-end pb-16">
      <div class="container mx-auto px-4 text-center">
        <div class="badge badge-primary badge-outline mb-4">{a.badge}</div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={a.heading} />
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1">
          <h2 class="text-3xl font-bold mb-6">{a.historyHeading}</h2>
          <div class="space-y-4 text-base-content/70">
            {a.history.map((p) => (<p>{p}</p>))}
          </div>
        </div>
        <div class="flex-1">
          <div class="stats shadow lg:stats-vertical">
            <div class="stat">
              <div class="stat-figure text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="stat-title">{a.statFoundation}</div>
              <div class="stat-value text-primary">1970</div>
              <div class="stat-desc">{a.statFoundationDesc}</div>
            </div>
            <div class="stat">
              <div class="stat-figure text-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="stat-title">{a.statOffices}</div>
              <div class="stat-value text-secondary">1</div>
              <div class="stat-desc">{a.statLocation}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y Visión -->
  <section class="py-20 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl text-primary mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              {a.missionHeading}
            </h2>
            <p class="text-base-content/80">
              {a.mission}
            </p>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl text-secondary mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              {a.visionHeading}
            </h2>
            <p class="text-base-content/80">
              {a.vision}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{a.valuesHeading}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          a.values.map((v, i) => {
            const accent = ["primary", "secondary", "accent", "info"][i] || "primary";
            const icon = [
              "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
              "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
              "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
              "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
            ][i];
            return (
              <div class={`card bg-base-100 border border-base-300 hover:border-${accent} transition-colors`}>
                <div class="card-body items-center text-center">
                  <div class={`w-16 h-16 rounded-full bg-${accent}/10 flex items-center justify-center mb-4`}>
                    <svg xmlns="http://www.w3.org/2000/svg" class={`h-8 w-8 text-${accent}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon} />
                    </svg>
                  </div>
                  <h3 class="card-title">{v.title}</h3>
                  <p class="text-sm text-base-content/70">{v.text}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="py-20 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{a.teamHeading}</h2>
        <p class="text-base-content/70 max-w-2xl mx-auto">
          {a.teamLead}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {a.team.map((member) => (
          <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow overflow-hidden">
            <figure class="h-64 overflow-hidden">
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </figure>
            <div class="card-body text-center">
              <h3 class="card-title text-lg justify-center">{member.name}</h3>
              <p class="text-sm text-primary font-medium">{member.role}</p>
              <p class="text-sm text-base-content/70 mt-2">{member.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary text-primary-content">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{a.ctaHeading}</h2>
      <p class="text-primary-content/80 max-w-2xl mx-auto mb-8">
        {a.ctaLead}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={routeHref("services", lang)} class="btn btn-secondary btn-lg">{a.ctaServices}</a>
        <a href={routeHref("contact", lang)} class="btn btn-outline btn-lg border-primary-content text-primary-content hover:bg-primary-content hover:text-primary">{a.ctaContact}</a>
      </div>
    </div>
  </section>
</MainLayout>
