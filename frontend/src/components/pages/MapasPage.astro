---
import MainLayout from "../../layouts/MainLayout.astro";
import MapasCatalogo from "./MapasCatalogo.astro";
import type { Lang } from "../../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === "es";
const title = es ? "Galería de ortomosaicos en Chiriquí" : "Orthomosaic gallery in Chiriquí";
const description = es
  ? "Explore ortomosaicos de levantamientos topográficos con drones en Chiriquí y Panamá, publicados por Topografía Especializada."
  : "Explore drone survey orthomosaics from Chiriquí and Panama, published by Topografía Especializada.";
const indexPath = es ? "/mapas/" : "/en/mapas/";
---

<MainLayout
  title={title}
  description={description}
  lang={lang}
  breadcrumbs={[{ name: es ? "Mapas" : "Maps", path: indexPath }]}
>
  <section class="relative overflow-hidden bg-[#05070f] text-white">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="pointer-events-none absolute -right-32 -top-40 h-[30rem] w-[30rem] rounded-full bg-[#2b5cff]/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-mono text-xs uppercase tracking-[.22em] text-[#9db4ff]">{es ? "Fotogrametría · David, Chiriquí" : "Photogrammetry · David, Chiriquí"}</p>
      <h1 class="mt-5 max-w-4xl font-display text-4xl font-bold leading-[1.04] tracking-tight sm:text-6xl lg:text-7xl">
        {es ? <>Territorio visto <span class="text-[#91aaff]">con precisión.</span></> : <>The land, seen <span class="text-[#91aaff]">in detail.</span></>}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-white/70 sm:text-lg">
        {es
          ? "Ortomosaicos creados a partir de levantamientos con drones y procesamiento geoespacial. Abra cada proyecto y explore la imagen en su ubicación real."
          : "Orthomosaics produced from drone surveys and geospatial processing. Open a project and explore its imagery at the real location."}
      </p>
      <a href="#galeria" class="btn btn-primary mt-8 min-h-12 rounded-full px-6">
        {es ? "Explorar galería" : "Explore the gallery"}
      </a>
    </div>
  </section>

  <MapasCatalogo lang={lang} />
</MainLayout>
