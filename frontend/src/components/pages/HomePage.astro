---
import MainLayout from "../../layouts/MainLayout.astro";
import MapasCatalogo from "./MapasCatalogo.astro";
import { ui, type Lang } from "../../i18n/ui";
import { routeHref } from "../../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const mapsHref = routeHref("maps", lang);
const quoteHref = `${routeHref("services", lang)}#cotizacion`;
---

<MainLayout title={h.title} description={h.description} lang={lang}>
  <!-- ================= MAPAS DE DRONES ================= -->
  <section class="relative isolate overflow-hidden bg-[#05070f] text-white">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-35"></div>
    <div class="pointer-events-none absolute -right-32 -top-32 h-[34rem] w-[34rem] rounded-full bg-[#2b5cff]/18 blur-3xl"></div>
    <div class="relative mx-auto grid w-full max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-18 lg:min-h-[calc(100svh-5rem)] lg:grid-cols-[1fr_.82fr] lg:gap-16 lg:py-16">
      <div class="max-w-3xl">
        <p class="inline-flex min-h-10 items-center gap-3 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 font-mono text-[10px] uppercase tracking-[.2em] text-[#d5deff] sm:text-xs">
          <span class="h-2 w-2 rounded-full bg-primary"></span>{h.heroBadge}
        </p>

        <h1 class="mt-6 max-w-3xl font-display text-4xl font-bold leading-[1.03] tracking-tight sm:text-6xl lg:text-7xl" set:html={h.heroTitle} />
        <p class="mt-6 max-w-xl text-base leading-7 text-white/75 sm:text-lg sm:leading-8">{h.heroLead}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={mapsHref} class="btn btn-primary min-h-12 rounded-full px-7">{h.ctaPrimary}</a>
          <a href={quoteHref} class="btn min-h-12 rounded-full border border-white/25 bg-white/[0.04] px-7 text-white hover:border-primary/60 hover:bg-white/[0.08]">{h.ctaSecondary}</a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label={h.deliverablesLabel}>
          {h.deliverables.map((item) => (
            <li class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2 font-mono text-[10px] uppercase tracking-wider text-white/70 sm:text-[11px]">{item}</li>
          ))}
        </ul>
      </div>

      <figure class="relative mx-auto w-full max-w-[28rem] lg:max-w-none">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/10 bg-[#081328] shadow-2xl shadow-blue-950/40">
          <img
            src="/images/176070209_204156991250335_7340951298165577398_n.jpg"
            alt={h.droneImageAlt}
            width="1080"
            height="1350"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover object-center"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#05070f]/90 via-[#05070f]/10 to-[#05070f]/15"></div>
          <div class="absolute left-4 right-4 top-4 flex items-center justify-between gap-3 sm:left-5 sm:right-5 sm:top-5">
            <span class="rounded-full border border-white/20 bg-[#05070f]/65 px-3 py-2 font-mono text-[10px] uppercase tracking-[.15em] text-white backdrop-blur">{h.dronePhotoLabel}</span>
            <span class="rounded-full border border-white/20 bg-[#05070f]/65 px-3 py-2 font-mono text-[10px] uppercase tracking-[.15em] text-white/80 backdrop-blur">{h.locationLabel}</span>
          </div>
          <figcaption class="absolute inset-x-5 bottom-5 sm:inset-x-7 sm:bottom-7">
            <p class="font-mono text-[10px] uppercase tracking-[.2em] text-[#b7c6ff]">{h.dronePhotoKicker}</p>
            <p class="mt-2 font-display text-2xl font-semibold leading-tight text-white sm:text-3xl">{h.dronePhotoCaption}</p>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  <MapasCatalogo lang={lang} featured />

  <!-- ================= MARQUEE de capacidades ================= -->
  <section class="hud-line relative overflow-hidden border-y border-black/5 bg-base-200/40 py-4">
    <div class="flex w-max animate-marquee gap-10 whitespace-nowrap pr-10">
      {[...h.capabilities, ...h.capabilities].map((c) => (
        <span class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-base-content/55">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>{c}
        </span>
      ))}
    </div>
  </section>

  <!-- ================= MÉTRICAS ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {h.metrics.map((m, i) => (
        <div class="reveal glass rounded-2xl p-6 text-center" style={`transition-delay:${i * 60}ms`}>
          <p class="font-display text-4xl font-bold text-base-content sm:text-5xl">
            <span class="counter" data-target={m.value}>0</span><span class="text-primary">{m.suffix}</span>
          </p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-widest text-base-content/55">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= SERVICIOS ================= -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-primary">{h.servicesKicker}</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl" set:html={h.servicesHeading} />
      </div>
      <a href={routeHref("services", lang)} class="font-mono text-xs uppercase tracking-widest text-base-content/60 transition-colors hover:text-primary">{h.servicesViewAll}</a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {h.services.map((s, i) => (
        <article class="reveal group relative overflow-hidden rounded-3xl border border-black/5 bg-base-200" style={`transition-delay:${i * 50}ms`}>
          <div class="relative h-52 overflow-hidden">
            <img src={s.image} alt={s.title} style={("pos" in s && s.pos) ? `object-position:${s.pos}` : undefined} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-base-200 via-base-200/30 to-transparent"></div>
            <span class="absolute left-4 top-4 rounded-full border border-white/15 bg-black/40 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-primary backdrop-blur">{s.tag}</span>
          </div>
          <div class="p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-lg font-semibold text-base-content">{s.title}</h3>
              {"price" in s && s.price && (
                <span class="shrink-0 rounded-full bg-primary/15 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-primary">{s.price}</span>
              )}
            </div>
            <p class="mt-2 text-sm text-base-content/65">{s.description}</p>
          </div>
          <div class="pointer-events-none absolute inset-0 rounded-3xl ring-1 ring-inset ring-transparent transition group-hover:ring-primary/40"></div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= TECNOLOGÍA ================= -->
  <section class="relative overflow-hidden border-y border-black/5 bg-base-200/40">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2">
      <div class="reveal relative">
        <div class="glow-blue overflow-hidden rounded-3xl">
          <img src="/images/20241125_101126.jpg" alt={h.techImageAlt} class="w-full object-cover" loading="lazy" />
        </div>
        <div class="glass absolute -bottom-6 -right-4 rounded-2xl p-4 sm:right-6">
          <p class="font-mono text-[10px] uppercase tracking-widest text-primary">{h.techCardLabel}</p>
          <p class="mt-1 font-display text-xl font-bold">{h.techCardValue}</p>
        </div>
      </div>
      <div class="reveal">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-primary">{h.techKicker}</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl" set:html={h.techHeading} />
        <p class="mt-5 text-base-content/70">
          {h.techLead}
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {h.techFeatures.map((f) => (
            <li class="flex items-center gap-3 rounded-xl border border-black/5 bg-white/[0.03] px-4 py-3 text-sm">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">✓</span>{f}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= PROCESO ================= -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
    <div class="reveal text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-primary">{h.processKicker}</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl" set:html={h.processHeading} />
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-4">
      {h.steps.map((s, i) => (
        <div class="reveal relative rounded-2xl border border-black/5 bg-base-200 p-6" style={`transition-delay:${i * 70}ms`}>
          <span class="font-display text-5xl font-bold text-primary/25">{s.n}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-base-content">{s.t}</h3>
          <p class="mt-2 text-sm text-base-content/65">{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <div class="reveal glow-blue relative overflow-hidden rounded-[2rem] border border-primary/30 bg-gradient-to-br from-primary/25 via-base-200 to-base-200 p-10 sm:p-16">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
      <div class="relative flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">{h.ctaHeading}</h2>
          <p class="mt-3 max-w-xl text-base-content/75">{h.ctaLead}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={routeHref("services", lang) + "#cotizacion"} class="btn btn-primary btn-lg rounded-full px-8">{h.ctaButton}</a>
          <a href="tel:+50766714646" class="btn btn-lg rounded-full border border-white/25 bg-black/25 px-8 text-white backdrop-blur hover:bg-black/40">{h.ctaCall}</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Contadores
  const counters = document.querySelectorAll<HTMLElement>(".counter");
  const cio = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      const target = Number(el.dataset.target || "0");
      const start = performance.now();
      const dur = 1400;
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString(document.documentElement.lang === "en" ? "en-US" : "es-PA");
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      cio.unobserve(el);
    }
  }, { threshold: 0.4 });
  counters.forEach((c) => cio.observe(c));
</script>
