---
import MainLayout from "../../layouts/MainLayout.astro";
import { ui, type Lang } from "../../i18n/ui";
import { routeHref } from "../../i18n/utils";
import PrintQuoteForm from "../PrintQuoteForm.astro";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const s = t.services;

const origin = (Astro.site ? new URL("/", Astro.site).href : "https://www.ricardosanjur.com/").replace(/\/$/, "");
const servicesLd = [
  ...s.items.map((item) => ({
    "@type": "Service",
    "@id": `${origin}/services/#${item.id}`,
    name: item.title,
    description: item.description,
    serviceType: item.title,
    areaServed: { "@type": "Country", name: "Panamá" },
    provider: { "@id": `${origin}/#organization` },
  })),
  {
    "@type": "Service",
    "@id": `${origin}/services/#copias-planos`,
    name: s.print.heading,
    description: s.print.description,
    serviceType: s.print.serviceType,
    areaServed: { "@type": "Country", name: "Panamá" },
    provider: { "@id": `${origin}/#organization` },
  },
];
const printWhatsAppUrl = `https://wa.me/50766714646?text=${encodeURIComponent("Hola, quiero cotizar copias, escaneo o impresión de planos.")}`;
---

<MainLayout
  title={s.title}
  description={s.description}
  lang={lang}
  breadcrumbs={[{ name: s.title, path: routeHref("services", lang) }]}
  extraJsonLd={servicesLd}
>

  <!-- Hero -->
  <section class="relative h-[50vh] min-h-[400px] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/Home7-2.jpg" alt={s.heroImageAlt} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="relative z-10 h-full flex items-end pb-16">
      <div class="container mx-auto px-4 text-center">
        <div class="badge badge-primary badge-outline mb-4">{s.badge}</div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={s.heading} />
        <p class="text-lg text-white/80 max-w-2xl mx-auto">
          {s.lead}
        </p>
      </div>
    </div>
  </section>

  <!-- Copias, escaneo e impresión: servicio destacado y mini-cotización -->
  <section id="copias-planos" class="border-b border-black/5 bg-base-200/50 py-14 sm:py-20">
    <div class="container mx-auto grid max-w-7xl grid-cols-1 items-start gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] lg:gap-12">
      <div class="pt-2">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-primary">{s.print.kicker}</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight sm:text-4xl">{s.print.heading}</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-base-content/70">{s.print.lead}</p>

        <ul class="mt-6 grid gap-3">
          {s.print.items.map((item) => (
            <li class="flex items-start gap-3 rounded-xl border border-base-300 bg-base-100 px-4 py-3 text-sm font-medium">
              <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 rounded-2xl border border-primary/15 bg-base-100 p-4">
          <h3 class="font-semibold">{s.print.otherHeading}</h3>
          <ul class="mt-2 grid gap-2">
            {s.print.otherItems.map((item) => (
              <li class="flex items-start gap-2 text-sm leading-relaxed text-base-content/70">
                <span class="mt-0.5 text-primary" aria-hidden="true">✓</span><span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="#mini-cotizacion" class="btn btn-primary min-h-12 w-full rounded-full sm:w-auto">{s.print.cta}</a>
          <a href={printWhatsAppUrl} target="_blank" rel="noopener noreferrer" class="btn min-h-12 w-full rounded-full border border-[#25D366]/40 bg-[#25D366]/10 text-[#116b37] hover:bg-[#25D366]/15 sm:w-auto">
            {s.print.whatsapp}
          </a>
        </div>

      </div>
      <div class="min-w-0">
        <PrintQuoteForm lang={lang} />
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {s.items.map(service => (
          <div id={service.id} class="card bg-base-100 border border-base-300 shadow-lg hover:shadow-xl transition-all scroll-mt-24 overflow-hidden">
            <div class="flex flex-col md:flex-row">
              <figure class="md:w-1/3 h-48 md:h-auto">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </figure>
              <div class="card-body md:w-2/3">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-3xl">{service.icon}</span>
                  <h2 class="card-title text-xl">{service.title}</h2>
                </div>
                <p class="text-base-content/70 mb-4 text-sm">{service.description}</p>
                <ul class="grid grid-cols-2 gap-1 mb-4">
                  {service.features.map(feature => (
                    <li class="flex items-center gap-1 text-xs">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
                <div class="flex items-center justify-between mt-auto">
                  <span class="text-xl font-bold text-primary">{service.price}</span>
                  <a href="#cotizacion" class="btn btn-primary btn-sm">{s.request}</a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formulario de Cotización -->
  <section id="cotizacion" class="py-20 bg-base-200 scroll-mt-24">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{s.quoteHeading}</h2>
        <p class="text-base-content/70 max-w-2xl mx-auto">
          {s.quoteLead}
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <form class="card bg-base-100 shadow-xl" id="quoteForm" method="post" action="/api/contact" data-msg-sent={s.msgSent} data-msg-error={s.msgError} data-msg-conn={s.msgConnError}>
          <div class="card-body space-y-6">

            <!-- Datos Personales -->
            <div class="border-b border-base-300 pb-4">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                {s.personalHeading}
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelFullName}</span></label>
                  <input type="text" name="nombre" class="input input-bordered" required placeholder={s.placeholderName} />
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelCompany}</span></label>
                  <input type="text" name="empresa" class="input input-bordered" placeholder={s.placeholderCompany} />
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelEmail}</span></label>
                  <input type="email" name="email" class="input input-bordered" required placeholder={s.placeholderEmail} />
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelPhone}</span></label>
                  <input type="tel" name="telefono" class="input input-bordered" required placeholder={s.placeholderPhone} />
                </div>
              </div>
            </div>

            <!-- Datos de la Finca -->
            <div class="border-b border-base-300 pb-4">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {s.propertyHeading}
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control md:col-span-2">
                  <label class="label"><span class="label-text">{s.labelUbicacion}</span></label>
                  <select name="ubicacion" class="select select-bordered">
                    <option value="">Seleccione una opción</option>
                    {s.ubicacionOpciones.map((u) => (<option value={u}>{u}</option>))}
                  </select>
                </div>
                <div class="form-control md:col-span-2">
                  <label class="label"><span class="label-text">{s.labelAddress}</span></label>
                  <input type="text" name="direccion" class="input input-bordered" required placeholder={s.placeholderAddress} />
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelPlotNumber}</span></label>
                  <input type="text" name="numeroFinca" class="input input-bordered" required placeholder={s.placeholderPlotNumber} />
                </div>
                <div class="form-control">
                  <label class="label"><span class="label-text">{s.labelArea}</span></label>
                  <input type="text" name="area" class="input input-bordered" placeholder={s.placeholderArea} />
                </div>
              </div>
            </div>

            <!-- Tipo de Servicio -->
            <div class="border-b border-base-300 pb-4">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                {s.serviceTypeHeading}
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3">
                {s.serviceTypes.map(type => (
                  <label class="label cursor-pointer justify-start items-start gap-2 min-w-0">
                    <input type="checkbox" name="tipoServicio" value={type} class="checkbox checkbox-primary checkbox-md" />
                    <span class="label-text text-sm whitespace-normal break-words leading-snug text-left">{type}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Características de la Finca -->
            <div class="border-b border-base-300 pb-4">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                </svg>
                {s.landHeading}
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 sm:gap-3">
                {s.landFeatures.map(feature => (
                  <label class="label cursor-pointer justify-start items-start gap-2 min-w-0">
                    <input type="checkbox" name="caracteristicaFinca" value={feature} class="checkbox checkbox-secondary checkbox-md" />
                    <span class="label-text text-sm whitespace-normal break-words leading-snug text-left">{feature}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Nota: el formulario ya NO sube archivos. Los planos se envian
                 luego por WhatsApp o correo, para que el envio nunca falle. -->

            <!-- Archivos: se piden por WhatsApp / correo, no por el formulario.
                 Subir archivos obligaba a un endpoint con multipart que nunca
                 llego a funcionar y tumbaba todo el envio. -->
            <div class="border-b border-base-300 pb-4">
              <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
                {s.docsHeading}
              </h3>
              <p class="text-sm text-base-content/70">{s.labelDocs}</p>
              <input
                type="file"
                name="archivos"
                id="archivosCotizacion"
                multiple
                accept=".pdf,.jpg,.jpeg,.png,.webp,.dwg,.dxf"
                class="sr-only"
              />
              <label for="archivosCotizacion" id="zonaArchivos"
                class="mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-primary/35 bg-primary/[0.04] px-4 py-6 text-center transition-colors hover:border-primary hover:bg-primary/[0.08] active:bg-primary/10">
                <span class="flex size-11 items-center justify-center rounded-full bg-primary/10 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 16V4m0 0L8 8m4-4 4 4" />
                    <path d="M4 16v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1" />
                  </svg>
                </span>
                <span class="font-medium text-base-content">Toca para subir tus planos</span>
                <span class="text-xs text-base-content/60" id="archivosAviso">{s.docsHint}</span>
              </label>
              <ul id="archivosLista" class="mt-2 space-y-1 text-sm"></ul>
            </div>

            <!-- Mensaje Adicional -->
            <div class="form-control">
              <label class="label"><span class="label-text">{s.labelMessage}</span></label>
              <textarea name="mensaje" class="textarea textarea-bordered h-24" placeholder={s.placeholderMessage}></textarea>
            </div>

            <!-- Submit -->
            <div class="form-control mt-6">
              <button type="submit" class="btn btn-primary btn-lg w-full whitespace-normal text-center leading-tight">
                {s.submit}
              </button>
            </div>
            <p class="text-xs leading-relaxed text-base-content/60">{s.quotePrivacyNotice}</p>

            <!-- Info adicional -->
            <div class="alert">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-sm">
                <p>{s.alertContact}</p>
                <p class="mt-1">{s.alertUrgent} <a href="tel:+50766714646" class="link link-primary">+507 6671-4646</a></p>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const messages = { sent: "", error: "", conn: "" };
  const form = document.getElementById('quoteForm') as HTMLFormElement;
  const formRoot = form;
  if (formRoot) {
    messages.sent = formRoot.dataset.msgSent || "";
    messages.error = formRoot.dataset.msgError || "";
    messages.conn = formRoot.dataset.msgConn || "";
  }

  // Boton de enviar: se desactiva mientras va el envio (evita dobles clics y
  // deja claro que SI esta pasando algo). Se restaura pase lo que pase.
  function setEnviando(activo: boolean) {
    const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = activo;
    btn.classList.toggle('btn-disabled', activo);
  }

  function marcar(sel: Element | null, valida: boolean) {
    if (!sel) return;
    const campo = sel as HTMLElement;
    campo.classList.toggle('input-error', !valida);
    campo.classList.toggle('textarea-error', !valida);
    campo.classList.toggle('select-error', !valida);
  }

  // Lista visible de archivos elegidos (sin esto el selector parece no hacer nada).
  const HINT_ARCHIVOS = 'PDF, JPG, PNG, WEBP, DWG o DXF · hasta 5 archivos · máx. 10 MB c/u';
  const inputArchivosEl = document.getElementById('archivosCotizacion') as HTMLInputElement | null;
  const listaArchivosEl = document.getElementById('archivosLista');
  const avisoArchivosEl = document.getElementById('archivosAviso');

  function formatoPeso(bytes: number) {
    if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
    return Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  function pintarArchivos(archivos: File[], error?: string) {
    if (!listaArchivosEl) return;
    listaArchivosEl.innerHTML = '';
    for (const a of archivos) {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-2 rounded-lg bg-base-200/70 px-3 py-2';
      const nombre = document.createElement('span');
      nombre.className = 'min-w-0 flex-1 truncate text-base-content/80';
      nombre.textContent = a.name;
      const peso = document.createElement('span');
      peso.className = 'shrink-0 font-mono text-xs text-base-content/50';
      peso.textContent = formatoPeso(a.size);
      li.append(nombre, peso);
      listaArchivosEl.append(li);
    }
    if (avisoArchivosEl) avisoArchivosEl.textContent = error || (archivos.length ? archivos.length + ' archivo(s) listos' : HINT_ARCHIVOS);
  }

  inputArchivosEl?.addEventListener('change', () => {
    pintarArchivos(inputArchivosEl.files ? Array.from(inputArchivosEl.files).slice(0, 5) : []);
  });

  // Arrastrar y soltar tambien funciona (en desktop es lo natural).
  const zona = document.getElementById('zonaArchivos');
  if (zona && inputArchivosEl) {
    ['dragenter', 'dragover'].forEach((ev) => zona.addEventListener(ev, (e) => { e.preventDefault(); zona.classList.add('border-primary', 'bg-primary/10'); }));
    ['dragleave', 'drop'].forEach((ev) => zona.addEventListener(ev, () => zona.classList.remove('border-primary', 'bg-primary/10')));
    zona.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (!dt || !dt.files || dt.files.length === 0) return;
      e.preventDefault();
      inputArchivosEl.files = dt.files;
      pintarArchivos(Array.from(dt.files).slice(0, 5));
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const valor = (k: string) => String(fd.get(k) || '').trim();

    // 1) Validacion visible: el navegador no la muestra cuando el submit se
    //    maneja por JS, y antes el boton parecia "no hacer nada".
    const obligatorios: [string, string][] = [
      ['nombre', 'El nombre es obligatorio.'],
      ['email', 'El correo es obligatorio.'],
      ['telefono', 'El telefono es obligatorio.'],
      ['direccion', 'La direccion es obligatoria.'],
      ['numeroFinca', 'El numero de finca es obligatorio.'],
    ];
    for (const [campo, aviso] of obligatorios) {
      const input = form.querySelector('[name="' + campo + '"]');
      const vacio = !valor(campo);
      marcar(input, !vacio);
      if (vacio) { alert(aviso); (input as HTMLInputElement)?.focus(); return; }
    }
    const inputEmail = form.querySelector('[name="email"]') as HTMLInputElement | null;
    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(valor('email'));
    marcar(inputEmail, emailOk);
    if (!emailOk) { alert('Revise el correo electronico.'); inputEmail?.focus(); return; }

    // 2) Los campos extra se arman como texto y viajan en "mensaje": el endpoint
    //    /api/contact ya existe, ya guarda y ya avisa por correo. Un solo camino.
    const servicios = fd.getAll('tipoServicio').map(String).filter(Boolean);
    const caracteristicas = fd.getAll('caracteristicaFinca').map(String).filter(Boolean);
    const lineas = [
      'SOLICITUD DE COTIZACION',
      'Empresa: ' + (valor('empresa') || '-'),
      'Ubicacion del trabajo: ' + (valor('ubicacion') || '-'),
      'Direccion de la finca: ' + valor('direccion'),
      'Numero de finca: ' + valor('numeroFinca'),
      'Area aproximada: ' + (valor('area') || '-'),
      'Tipo de servicio: ' + (servicios.length ? servicios.join(', ') : '-'),
      'Caracteristicas: ' + (caracteristicas.length ? caracteristicas.join(', ') : '-'),
      '',
      'Mensaje:',
      valor('mensaje') || '(sin mensaje adicional)',
    ];
    const payload = {
      nombre: valor('nombre'),
      email: valor('email'),
      telefono: valor('telefono'),
      tema: 'cotizacion',
      mensaje: lineas.join('\n'),
    };

    // 3) Adjuntos: se suben ANTES del texto y por un camino aparte. Si fallan,
    //    el mensaje sale igual (lo importante nunca se pierde) y se avisa.
    const inputArchivos = inputArchivosEl;
    const archivos = inputArchivos?.files ? Array.from(inputArchivos.files).slice(0, 5) : [];
    const ref = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + '-' + Math.random().toString(16).slice(2)).toLowerCase();
    let subidaOk = true;
    if (archivos.length > 0) {
      const aviso = avisoArchivosEl;
      if (aviso) aviso.textContent = 'Subiendo ' + archivos.length + ' archivo(s)...';
      try {
        const fdArch = new FormData();
        archivos.forEach((a) => fdArch.append('archivos', a));
        const r = await fetch('/api/contact/files?ref=' + encodeURIComponent(ref), { method: 'POST', body: fdArch });
        subidaOk = r.ok;
      } catch (e) {
        subidaOk = false;
      }
      if (aviso) {
        aviso.textContent = subidaOk
          ? 'Archivos subidos.'
          : 'No se pudieron subir los archivos; la solicitud se envia igual.';
      }
    }

    setEnviando(true);
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: JSON.stringify({ ...payload, ref }),
        headers: { 'Content-Type': 'application/json' },
      });

      if (response.ok) {
        alert(subidaOk || archivos.length === 0 ? messages.sent : messages.sent + '\n\n(Ojo: los archivos no se pudieron subir.)');
        form.reset();
        pintarArchivos([]);
      } else {
        alert(messages.error);
      }
    } catch (error) {
      alert(messages.conn);
    } finally {
      setEnviando(false);
    }
  });
</script>
