---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { ui, type Lang } from "../../i18n/ui";
import { localePath, routeHref } from "../../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const b = t.blog;

const posts = await getCollection(lang === "en" ? "blogEn" : "blog");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString(t.dateLocale, {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
}
---

<MainLayout title={b.title} description={b.description} lang={lang}>

  <!-- Hero -->
  <section class="relative h-[50vh] min-h-[400px] overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/20241125_101126.jpg" alt={b.heroImageAlt} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>
    <div class="relative z-10 h-full flex items-center">
      <div class="container mx-auto px-4 text-center">
        <div class="badge badge-primary badge-outline mb-4">{b.badge}</div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" set:html={b.heading} />
        <p class="text-lg text-white/80 max-w-2xl mx-auto">
          {b.lead}
        </p>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <div class="w-24 h-24 rounded-full bg-base-200 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold mb-2">{b.emptyHeading}</h2>
          <p class="text-base-content/70">{b.emptyLead}</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
              <div class="card-body">
                <div class="flex items-center gap-2 text-sm text-base-content/50 mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </div>

                <h2 class="card-title text-xl mb-3">
                  <a href={localePath(`/blog/${post.id}`, lang)} class="hover:text-primary transition-colors">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-base-content/70 text-sm mb-4 line-clamp-3">
                  {post.data.summary}
                </p>

                <div class="flex items-center justify-between mt-auto">
                  <div class="flex items-center gap-2">
                    <div class="avatar placeholder">
                      <div class="bg-primary/10 text-primary rounded-full w-8 h-8">
                        <span class="text-xs">{post.data.author.charAt(0)}</span>
                      </div>
                    </div>
                    <span class="text-sm text-base-content/70">{post.data.author}</span>
                  </div>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="badge badge-ghost badge-sm">
                      {post.data.tags[0]}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-20 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">{b.newsletterHeading}</h2>
        <p class="text-base-content/70 mb-6">
          {b.newsletterLead}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={`mailto:gerencia@ricardosanjur.com?subject=${encodeURIComponent(b.subscribeSubject)}`} class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {b.subscribe}
          </a>
          <a href={routeHref("contact", lang)} class="btn btn-outline btn-primary">{b.contact}</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
