{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ricardosanjur-web",
  "account_id": "66f8699b20c28ad6be430da2eaa98d34",
  "compatibility_date": "2026-10-10",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin*", "/blog*", "/mis-planos*", "/mis-solicitudes*", "/api*", "/certificado*"]
  },
  "routes": [
    { "pattern": "www.ricardosanjur.com/*", "zone_name": "ricardosanjur.com" },
    { "pattern": "ricardosanjur.com/*", "zone_name": "ricardosanjur.com" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topografia-planos-db",
      "database_id": "6d3a71a3-f89b-449b-8306-db1437bd2ea6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PLANOS",
      "bucket_name": "topografia-planos-media"
    }
  ]
}
